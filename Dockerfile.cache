# Cache image for the expensive, rarely-changing build prerequisites:
# the gcc/musl-dev toolchain (~200 MB) and the Go module downloads.
#
# CNB builds this image once and reuses it for every subsequent pipeline run,
# so `prepare build args` no longer re-downloads the toolchain or the module
# graph. It is rebuilt only when Dockerfile.cache or go.mod/go.sum changes
# (see the `versionBy` list in .cnb.yml).
FROM golang:1.26-alpine

ARG ALPINE_BRANCH=v3.23
ARG APK_MIRROR=https://mirrors.aliyun.com/alpine

WORKDIR /app

# Pin the Alpine branch and mirror explicitly instead of rewriting whatever
# repositories the base image happens to ship. Otherwise the same apk command
# can resolve to a different (and much slower) package set between builds.
RUN set -eux; \
    printf '%s/%s/main\n%s/%s/community\n' \
        "${APK_MIRROR}" "${ALPINE_BRANCH}" \
        "${APK_MIRROR}" "${ALPINE_BRANCH}" \
        > /etc/apk/repositories; \
    rm -rf /var/cache/apk/*; \
    for i in 1 2 3; do \
        if apk add --no-cache gcc musl-dev; then break; fi; \
        if [ "$i" = "3" ]; then exit 1; fi; \
        sleep 5; \
    done; \
    rm -rf /var/cache/apk/*

COPY go.mod go.sum ./

ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.google.cn
ENV GOFLAGS=-mod=mod

RUN set -eux; \
    for i in 1 2 3; do \
        if go mod download; then break; fi; \
        if [ "$i" = "3" ]; then exit 1; fi; \
        sleep 5; \
    done; \
    go mod verify
