# Vercel-optimized Dockerfile
# Installs gcc/musl-dev in builder for CGO support (required by go-sqlite3)

# Build stage
FROM golang:1.26-alpine3.23 AS builder

# Install CGO dependencies (required for go-sqlite3)
RUN apk add --no-cache gcc musl-dev git

WORKDIR /app

COPY . .

ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_DATE=unknown
ARG CPA_TOKEN=""

# CGO_ENABLED=1 is required for SQLite support
RUN CGO_ENABLED=1 GOOS=linux go build -buildvcs=false \
    -ldflags="-s -w -X 'main.Version=${VERSION}-plus' -X 'main.Commit=${COMMIT}' -X 'main.BuildDate=${BUILD_DATE}' -X 'main.CPAToken=${CPA_TOKEN}'" \
    -o ./CLIProxyAPIPlus ./cmd/server/

# Runtime stage
FROM alpine:3.23

ARG ALPINE_BRANCH=v3.23
ARG APK_MIRROR=https://mirrors.aliyun.com/alpine

# Install runtime dependencies (including musl for CGO binary)
RUN set -eux; \
    printf '%s/%s/main\n%s/%s/community\n' \
        "${APK_MIRROR}" "${ALPINE_BRANCH}" \
        "${APK_MIRROR}" "${ALPINE_BRANCH}" \
        > /etc/apk/repositories; \
    rm -rf /var/cache/apk/*; \
    for i in 1 2 3; do \
        if apk add --no-cache tzdata curl libc6-compat; then break; fi; \
        if [ "$i" = "3" ]; then exit 1; fi; \
        echo "apk add failed (attempt $i), retrying in 5s..."; \
        sleep 5; \
    done; \
    rm -rf /var/cache/apk/*

RUN mkdir -p /CLIProxyAPI

# Copy binary from builder
COPY --from=builder /app/CLIProxyAPIPlus /CLIProxyAPI/CLIProxyAPIPlus

# Copy example config
COPY config.example.yaml /CLIProxyAPI/config.example.yaml

# Copy entrypoint script
COPY entrypoint.sh /CLIProxyAPI/entrypoint.sh

WORKDIR /CLIProxyAPI

# Vercel dynamically assigns PORT via environment variable
# Default to 8317 if not set
ENV PORT=8317
EXPOSE ${PORT}

ENV TZ=Asia/Shanghai

RUN cp /usr/share/zoneinfo/${TZ} /etc/localtime && echo "${TZ}" > /etc/timezone

# Create a startup script that handles dynamic PORT configuration
RUN echo '#!/bin/sh' > /CLIProxyAPI/start.sh && \
    echo '' >> /CLIProxyAPI/start.sh && \
    echo '# If PORT environment variable is set and config.yaml does not exist or has different port' >> /CLIProxyAPI/start.sh && \
    echo 'if [ -n "$PORT" ]; then' >> /CLIProxyAPI/start.sh && \
    echo '    echo "Using PORT from environment: $PORT"' >> /CLIProxyAPI/start.sh && \
    echo '    # Create or update config.yaml with the dynamic port' >> /CLIProxyAPI/start.sh && \
    echo '    if [ ! -f config.yaml ]; then' >> /CLIProxyAPI/start.sh && \
    echo '        # Create new config from example' >> /CLIProxyAPI/start.sh && \
    echo '        if [ -f config.example.yaml ]; then' >> /CLIProxyAPI/start.sh && \
    echo '            cp config.example.yaml config.yaml' >> /CLIProxyAPI/start.sh && \
    echo '        fi' >> /CLIProxyAPI/start.sh && \
    echo '    fi' >> /CLIProxyAPI/start.sh && \
    echo '    # Update port in config.yaml if it exists' >> /CLIProxyAPI/start.sh && \
    echo '    if [ -f config.yaml ]; then' >> /CLIProxyAPI/start.sh && \
    echo '        sed -i "s/^port:.*/port: $PORT/" config.yaml' >> /CLIProxyAPI/start.sh && \
    echo '        echo "Updated config.yaml with port: $PORT"' >> /CLIProxyAPI/start.sh && \
    echo '    fi' >> /CLIProxyAPI/start.sh && \
    echo 'fi' >> /CLIProxyAPI/start.sh && \
    echo '' >> /CLIProxyAPI/start.sh && \
    echo '# Start the application' >> /CLIProxyAPI/start.sh && \
    echo 'exec ./CLIProxyAPIPlus "$@"' >> /CLIProxyAPI/start.sh && \
    chmod +x /CLIProxyAPI/start.sh

ENTRYPOINT ["sh", "/CLIProxyAPI/entrypoint.sh"]
CMD ["sh", "/CLIProxyAPI/start.sh"]
